# Copy to .env.local for local development. In production these are set as
# GitHub Actions "Variables" (Settings → Secrets and variables → Actions → Variables).
NEXT_PUBLIC_SITE_URL=https://hirestaffislamabad.com
# Only publish real, verified contact details — they feed LocalBusiness schema.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=            # digits with country code, e.g. 923001234567
NEXT_PUBLIC_EMAIL=info@hirestaffislamabad.com
NEXT_PUBLIC_STREET_ADDRESS=      # leave empty for a service-area business without a public office
NEXT_PUBLIC_ADDRESS_LOCALITY=Islamabad
NEXT_PUBLIC_POSTAL_CODE=
NEXT_PUBLIC_OPENING_HOURS=       # schema.org format, e.g. Mo-Sa 09:00-19:00
NEXT_PUBLIC_GBP_URL=             # Google Business Profile / Maps link
NEXT_PUBLIC_SAME_AS=             # comma-separated social profile URLs
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SITE_INDEXING=true
